---
import '../styles/global.css';
import categoriesData from '../data/categories.json';
import { getCollection } from 'astro:content';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
  activeCategory?: string;
  noindex?: boolean;
}

const {
  title,
  description = "e-roadster. — Le blog dédié à la voiture électrique : assurance, entretien, recharge et conseils.",
  canonical,
  ogType = 'website',
  ogImage,
  publishedTime,
  modifiedTime,
  author,
  jsonLd,
  activeCategory,
  noindex = false,
} = Astro.props;

const siteUrl = 'https://e-roadster.fr';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const resolvedOgImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).toString())
  : new URL('/wp-content/uploads/default-og.jpg', siteUrl).toString();

// Nav : n'afficher que les catégories qui contiennent au moins un article
// réel — calculé dynamiquement pour se corriger automatiquement le jour où
// une catégorie aujourd'hui vide (ex: "assurance") reçoit son premier article.
const allNavPosts = await getCollection('posts');
const navCategories = categoriesData
  .filter((c) => allNavPosts.some((p) => p.data.categories?.includes(c.slug)))
  .map((c) => ({ slug: c.slug, label: c.name }));
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Manrope:wght@500;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="e-roadster." />
    <meta property="og:locale" content="fr_FR" />
    {ogImage && <meta property="og:image" content={resolvedOgImage} />}
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === 'article' && author && <meta property="article:author" content={author} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={resolvedOgImage} />}

    {jsonLd && (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <!-- Google Analytics (GA4) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CP6GH4DLMP"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CP6GH4DLMP');
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">e-roadster<span class="dot">.</span></a>
        <nav class="main-nav">
          <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Accueil</a>
          {navCategories.map((cat) => (
            <a
              href={`/category/${cat.slug}/`}
              class={activeCategory === cat.slug ? 'active' : ''}
            >
              {cat.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-brand">e-roadster.</p>
        <div class="footer-links">
          <a href="/mention-legal/">Mentions légales</a>
        </div>
        <p>&copy; {new Date().getFullYear()} e-roadster. — Tous droits réservés.</p>
      </div>
    </footer>
  </body>
</html>
