---
export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  jsonLd?: Record<string, any>;
}

const {
  title,
  description = "e-roadster. — Le blog dédié à la voiture électrique : assurance, entretien, recharge et conseils.",
  canonical,
  ogType = 'website',
  ogImage,
  publishedTime,
  modifiedTime,
  author,
  jsonLd,
} = Astro.props;

const siteUrl = 'https://e-roadster.fr';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const resolvedOgImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).toString())
  : new URL('/wp-content/uploads/default-og.jpg', siteUrl).toString();
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="e-roadster." />
    <meta property="og:locale" content="fr_FR" />
    {ogImage && <meta property="og:image" content={resolvedOgImage} />}
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === 'article' && author && <meta property="article:author" content={author} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={resolvedOgImage} />}

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">e-roadster.</a>
        <nav class="main-nav">
          <a href="/">Accueil</a>
          <a href="/category/voiture-electrique/">Voiture électrique</a>
          <a href="/category/entretien-et-recharge/">Entretien &amp; recharge</a>
          <a href="/category/assurance/">Assurance</a>
          <a href="/category/e-roadster/">e-roadster</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>&copy; {new Date().getFullYear()} e-roadster. — Tous droits réservés.</p>
        <p><a href="/mention-legal/">Mentions légales</a></p>
      </div>
    </footer>
    <style is:global>
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        color: #1a1a1a;
        line-height: 1.65;
        background: #fff;
      }
      .wrap { max-width: 860px; margin: 0 auto; padding: 0 1.25rem; }
      .site-header {
        border-bottom: 1px solid #eee;
        padding: 1rem 0;
      }
      .site-header .wrap { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; max-width: 1000px; }
      .brand { font-weight: 800; font-size: 1.35rem; color: #0a7d3f; text-decoration: none; }
      .main-nav { display: flex; gap: 1rem; flex-wrap: wrap; }
      .main-nav a { color: #333; text-decoration: none; font-size: 0.95rem; }
      .main-nav a:hover { color: #0a7d3f; text-decoration: underline; }
      main.wrap { max-width: 1000px; padding-top: 2rem; padding-bottom: 3rem; min-height: 60vh; }
      img { max-width: 100%; height: auto; }
      table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }
      table th, table td { border: 1px solid #ddd; padding: 0.5rem 0.75rem; text-align: left; }
      table th { background: #f5f5f5; }
      h1, h2, h3 { line-height: 1.3; }
      a { color: #0a7d3f; }
      .site-footer {
        border-top: 1px solid #eee;
        margin-top: 2rem;
        padding: 1.5rem 0;
        color: #666;
        font-size: 0.9rem;
      }
      .site-footer .wrap { max-width: 1000px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; }
      .post-card {
        border-bottom: 1px solid #eee;
        padding: 1.5rem 0;
      }
      .post-card h2 { margin: 0 0 0.4rem; font-size: 1.3rem; }
      .post-card h2 a { text-decoration: none; color: #111; }
      .post-card h2 a:hover { color: #0a7d3f; }
      .post-card .meta { color: #777; font-size: 0.85rem; margin-bottom: 0.5rem; }
      .post-card img { border-radius: 6px; margin-bottom: 0.75rem; }
      .article-header { margin-bottom: 1.5rem; }
      .article-header .meta { color: #777; font-size: 0.9rem; }
      .article-header h1 { margin-bottom: 0.5rem; }
      .article-cover { width: 100%; border-radius: 8px; margin: 1rem 0 2rem; }
      .category-badge {
        display: inline-block;
        background: #e6f6ec;
        color: #0a7d3f;
        border-radius: 999px;
        padding: 0.2rem 0.7rem;
        font-size: 0.8rem;
        text-decoration: none;
      }
    </style>
  </body>
</html>
