---
import '../styles/global.css';
import categoriesData from '../data/categories.json';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  jsonLd?: Record<string, any>;
  activeCategory?: string;
}

const {
  title,
  description = "e-roadster. — Le blog dédié à la voiture électrique : assurance, entretien, recharge et conseils.",
  canonical,
  ogType = 'website',
  ogImage,
  publishedTime,
  modifiedTime,
  author,
  jsonLd,
  activeCategory,
} = Astro.props;

const siteUrl = 'https://e-roadster.fr';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const resolvedOgImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).toString())
  : new URL('/wp-content/uploads/default-og.jpg', siteUrl).toString();

const navCategories = [
  { slug: 'voiture-electrique', label: 'Voiture électrique' },
  { slug: 'entretien-et-recharge', label: 'Entretien & recharge' },
  { slug: 'assurance', label: 'Assurance' },
  { slug: 'e-roadster', label: 'e-roadster' },
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="e-roadster." />
    <meta property="og:locale" content="fr_FR" />
    {ogImage && <meta property="og:image" content={resolvedOgImage} />}
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === 'article' && author && <meta property="article:author" content={author} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={resolvedOgImage} />}

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">e-roadster<span class="dot">.</span></a>
        <nav class="main-nav">
          <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Accueil</a>
          {navCategories.map((cat) => (
            <a
              href={`/category/${cat.slug}/`}
              class={activeCategory === cat.slug ? 'active' : ''}
            >
              {cat.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-brand">e-roadster.</p>
        <div class="footer-links">
          <a href="/mention-legal/">Mentions légales</a>
        </div>
        <p>&copy; {new Date().getFullYear()} e-roadster. — Tous droits réservés.</p>
      </div>
    </footer>
  </body>
</html>
