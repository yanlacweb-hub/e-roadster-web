---
import BaseLayout from './BaseLayout.astro';
import { extractFaqSchema } from '../utils/extractFaqSchema';

export interface Props {
  title: string;
  description: string;
  slug: string;
  date: string;
  modified?: string;
  image?: string;
  imageAlt?: string;
  author?: string;
  category?: string;
  categoryName?: string;
  readingMinutes?: number;
  rawBody?: string;
}

const {
  title, description, slug, date, modified, image, imageAlt, author = 'e-roadster.', category, categoryName, readingMinutes, rawBody,
} = Astro.props;

const siteUrl = 'https://e-roadster.fr';
const canonicalUrl = `${siteUrl}/${slug}/`;
const pageTitle = `${title} - e-roadster.`;
const imageUrl = image ? new URL(image, siteUrl).toString() : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date,
  dateModified: modified || date,
  author: author === 'Gabriel Dubois'
    ? { '@type': 'Person', name: author, url: `${siteUrl}/auteur-gabriel-dubois/` }
    : { '@type': 'Person', name: author },
  publisher: {
    '@type': 'Organization',
    name: 'e-roadster.',
    logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` },
  },
  ...(imageUrl ? { image: imageUrl } : {}),
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
};

// FAQPage : bloc JSON-LD additionnel (pas de remplacement du BlogPosting
// ci-dessus) injecté uniquement si une section FAQ a été détectée dans le
// corps de l'article. Voir src/utils/extractFaqSchema.ts.
const faqPairs = rawBody ? extractFaqSchema(rawBody) : [];
const faqJsonLd = faqPairs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqPairs.map((pair) => ({
        '@type': 'Question',
        name: pair.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: pair.answer,
        },
      })),
    }
  : undefined;
---
<BaseLayout
  title={pageTitle}
  description={description}
  canonical={canonicalUrl}
  ogType="article"
  ogImage={image}
  publishedTime={date}
  modifiedTime={modified}
  author={author}
  jsonLd={faqJsonLd ? [jsonLd, faqJsonLd] : jsonLd}
  activeCategory={category}
>
  <article class="article-shell">
    <div class="article-header">
      {category && (
        <a class="category-badge" data-category={category} href={`/category/${category}/`}>{categoryName || category}</a>
      )}
      <h1>{title}</h1>
      <p class="meta">
        <span>Publié le {new Date(date).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        {modified && modified !== date && (
          <span>— Mis à jour le {new Date(modified).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        )}
        {author && (author === 'Gabriel Dubois' ? <span>— par <a href="/auteur-gabriel-dubois/">{author}</a></span> : <span>— par {author}</span>)}
        {readingMinutes && <span class="meta-reading">{readingMinutes} min de lecture</span>}
      </p>
    </div>
    {image && <img class="article-cover" src={image} alt={imageAlt || title} width="1200" height="675" />}
    <div class="article-body">
      <slot />
    </div>
  </article>
</BaseLayout>
