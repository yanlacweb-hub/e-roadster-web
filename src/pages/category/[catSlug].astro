---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import categoriesData from '../../data/categories.json';
import { estimateReadingTime, formatReadingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  return categoriesData.map((cat) => ({
    params: { catSlug: cat.slug },
    props: { cat },
  }));
}

const { cat } = Astro.props;
const allPosts = await getCollection('posts');
const posts = allPosts
  .filter((p) => p.data.categories?.includes(cat.slug))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---
<BaseLayout
  title={cat.title || `${cat.name} - e-roadster.`}
  description={cat.description || `Articles de la catégorie ${cat.name} sur e-roadster.`}
  canonical={`https://e-roadster.fr/category/${cat.slug}/`}
  activeCategory={cat.slug}
>
  <h1 class="section-title">{cat.name}</h1>
  {cat.description && <p class="category-intro">{cat.description}</p>}
  <div class="post-list">
    {posts.length === 0 && <p class="empty-state">Aucun article dans cette catégorie pour le moment.</p>}
    {posts.map((post) => {
      const postCatInfo = categoriesData.find((c) => c.slug === post.data.category);
      const readingMinutes = estimateReadingTime(post.body ?? '');
      return (
        <article class="post-card">
          {post.data.image && (
            <a class="card-media" href={`/${post.data.postSlug}/`}>
              <img src={post.data.image} alt={post.data.imageAlt || post.data.title} loading="lazy" width="600" height="340" />
              {postCatInfo && <span class="category-badge" data-category={postCatInfo.slug}>{postCatInfo.name}</span>}
            </a>
          )}
          <div class="card-body">
            <p class="meta">
              <span class="meta-date">{new Date(post.data.date).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
              <span class="meta-sep" aria-hidden="true">&middot;</span>
              <span class="meta-reading">{formatReadingTime(readingMinutes)}</span>
            </p>
            <h2><a href={`/${post.data.postSlug}/`}>{post.data.title}</a></h2>
            <p class="excerpt">{post.data.description}</p>
            <a class="card-cta" href={`/${post.data.postSlug}/`} aria-hidden="true" tabindex="-1">
              Lire l&rsquo;article <span class="card-cta-arrow">&rarr;</span>
            </a>
          </div>
        </article>
      );
    })}
  </div>
</BaseLayout>
