---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryPageLayout from '../../components/CategoryPageLayout.astro';
import categoriesData from '../../data/categories.json';
import { getCategoryPosts, totalPagesFor, PER_PAGE } from '../../utils/categoryPosts';

export async function getStaticPaths() {
  return categoriesData.map((cat) => ({
    params: { catSlug: cat.slug },
    props: { cat },
  }));
}

const { cat } = Astro.props;
const allPosts = await getCollection('posts');
const posts = getCategoryPosts(allPosts, cat.slug);

const [featured, ...others] = posts;
const totalPages = totalPagesFor(others.length);
// Page 1 (URL canonique /category/<slug>/, sans suffixe /page/1/) : les 9
// premiers articles hors vedette.
const pageItems = others.slice(0, PER_PAGE);

// Sujets populaires (sidebar) : les autres vraies catégories avec leur nombre d'articles.
const popularTopics = categoriesData
  .filter((c) => c.slug !== cat.slug)
  .map((c) => ({
    ...c,
    count: allPosts.filter((p) => p.data.categories?.includes(c.slug)).length,
  }));

// Guide "à la une" de la catégorie (le plus ancien / le plus consulté par défaut : ici le 2e plus récent
// s'il existe, sinon le plus récent, pour éviter de dupliquer le featured en aside).
const guidePick = others[0] ?? featured;

// Couleur dédiée + image hero + label court par catégorie (maquette v2 client,
// /tmp/refonte-ux-v2/categorie.js -> objet `taxonomy`). Portés dans categories.json.
const categoryColor = cat.color ?? '#12b76a';

const siteUrl = 'https://e-roadster.fr';
const categoryJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: cat.title || `${cat.name} - e-roadster.`,
  description: cat.description || `Articles de la catégorie ${cat.name} sur e-roadster.`,
  url: `${siteUrl}/category/${cat.slug}/`,
  isPartOf: {
    '@type': 'WebSite',
    name: 'e-roadster.',
    url: siteUrl,
  },
};
---
<BaseLayout
  title={cat.title || `${cat.name} - e-roadster.`}
  description={cat.description || `Articles de la catégorie ${cat.name} sur e-roadster.`}
  canonical={`https://e-roadster.fr/category/${cat.slug}/`}
  activeCategory={cat.slug}
  noindex={posts.length === 0}
  jsonLd={categoryJsonLd}
>
  <CategoryPageLayout
    cat={cat}
    categoryColor={categoryColor}
    posts={posts}
    featured={featured}
    pageItems={pageItems}
    showFeatured={true}
    pageNum={1}
    totalPages={totalPages}
    popularTopics={popularTopics}
    guidePick={guidePick}
    basePath={`/category/${cat.slug}`}
  />
</BaseLayout>
